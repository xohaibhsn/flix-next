# Server-only Cloudinary credentials. Never expose the API secret to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sidhu bootstrap credentials. After the first admin_users row exists, login uses the database hash.
# Changing ADMIN_PASSWORD later does not overwrite a CMS-changed password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Deliberate emergency recovery only. Leave unset in normal production.
# Unset immediately after use. A Hostinger redeploy must not restore an old password.
# ADMIN_EMERGENCY_RECOVERY=1
# ADMIN_EMERGENCY_RESET_PASSWORD=1

# Server-only MySQL. Required in production; omit locally to use JSON CMS files.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Public indexing. Unset keeps current public indexing (do not noindex the live site by accident).
# Set to true to keep index/follow. Set to false only when you want a site-wide noindex.
SITE_INDEXABLE=

# Server-only Sidhu AI SEO Assistant (explain + title/meta draft). Never expose API keys to the browser.
# Leave keys empty locally until deliberately configured. SEO Health and editors still work without AI.
OPENAI_API_KEY=
OPENAI_SEO_MODEL=gpt-6-luna
# Optional override for UK opportunity research only. Falls back to OPENAI_SEO_MODEL when unset.
# OPENAI_SEO_RESEARCH_MODEL=
# OpenAI research (UK Opportunities) stays OpenAI-only.
# OPENAI_SEO_RESEARCH_MODEL=
# Phase D3: OpenAI ChatGPT writing-prompt generation. Requires BOTH OPENAI_API_KEY and this model.
# Does not fall back to OPENAI_SEO_MODEL or OPENAI_SEO_RESEARCH_MODEL.
OPENAI_BLOG_PROMPT_MODEL=
#
# Gemini SEO assistant (explain + title/meta draft only). Requires BOTH key and model.
# Do not reuse GEMINI_BLOG_PROMPT_MODEL here — that belongs to Phase D2 ChatGPT writing prompts.
GEMINI_API_KEY=
GEMINI_SEO_MODEL=
# Phase D2: Gemini ChatGPT writing-prompt generation. Requires BOTH GEMINI_API_KEY and this model.
# Does not fall back to GEMINI_SEO_MODEL.
GEMINI_BLOG_PROMPT_MODEL=
# Phase E2: Gemini ChatGPT image-prompt generation. Requires BOTH GEMINI_API_KEY and this model.
# Does not fall back to GEMINI_SEO_MODEL or GEMINI_BLOG_PROMPT_MODEL. Does not generate images.
GEMINI_IMAGE_PROMPT_MODEL=

# Server-only Google Search Console (GSC) — Phase GSC-1 foundation. Never expose to the browser.
# Leave unset until a service account is deliberately configured. Opportunities still works without GSC.
# GSC_SITE_URL must be the exact Search Console property string (copy from GSC settings), e.g.:
#   sc-domain:example.com
#   or https://example.com/
GSC_SITE_URL=
# Secret: service account client email
GSC_CLIENT_EMAIL=
# Secret: service account private key PEM. On Hostinger, store newlines as escaped \n sequences;
# the server normalizes \\n → real newlines. Never commit a real key.
GSC_PRIVATE_KEY=
# Optional Google Cloud project id (non-secret metadata)
GSC_PROJECT_ID=

